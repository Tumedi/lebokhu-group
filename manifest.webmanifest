    },
    {
      "name": "Register",
      "short_name": "Register",
      "description": "Register as a job seeker",
      "url": "./register.html",
      "icons": [{ "src": "assets/icon-192.svg", "sizes": "192x192", "type": "image/svg+xml" }]
    }
  ]
